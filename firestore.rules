rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // 誰でも閲覧可。ログイン済みスタッフのみ変更可。お客さんは発券（counters更新＋ticket作成）のみ可
    match /tickets/{id} {
      allow get: if true;
      // 一覧の取得はスタッフのみ（お客さんは自分の券と集計だけ読む）
      allow list: if request.auth != null;
      // お客さんは、1組2人までの券を作れる（スタッフは人数・番号とも自由）
      allow create: if request.auth != null
        || (request.resource.data.status == 'waiting'
            && request.resource.data.people in [1, 2]
            && (!('name' in request.resource.data) || request.resource.data.name.size() <= 12));
      // お客さんは、順番待ちの券の取り消しと、呼び出し中の券のもぎり（入室）だけ可
      allow update: if request.auth != null
        || (resource.data.status in ['waiting', 'skipped'] && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy']))
        || (resource.data.status == 'called' && request.resource.data.status == 'inroom'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'enteredAt', 'torn']))
        // 呼び出しがお客さんの画面に届いた印（seenAt）。呼び出し中の券に、1回だけ書ける
        || (resource.data.status == 'called' && request.resource.data.status == 'called'
            && !('seenAt' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seenAt']))
        // お客さんが、受付からのメッセージを見た・確認した印
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['msgSeenAt', 'msgAckAt'])
            && (!('msgSeenAt' in request.resource.data) || request.resource.data.msgSeenAt is number)
            && (!('msgAckAt' in request.resource.data) || request.resource.data.msgAckAt is number))
        // お客さんから受付への連絡（report）。100文字まで、何度でも送れる
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['report', 'reportAt', 'reportCode'])
            && request.resource.data.report is string && request.resource.data.report.size() <= 100
            && request.resource.data.reportAt is number
            && (!('reportCode' in request.resource.data) || (request.resource.data.reportCode is string && request.resource.data.reportCode.size() <= 40)));
      allow delete: if request.auth != null;
    }
    match /summary/{day} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /counters/{day} {
      allow read: if true;
      // お客さんは発券時の last の更新だけ可（停止フラグなどはスタッフのみ）
      // 3人以上は複数枚を一度に発行するので、1回で最大4枚（8人）まで増やせる
      allow create: if request.auth != null
        || (request.resource.data.keys().hasOnly(['last', 'gLast']) && request.resource.data.last >= 1 && request.resource.data.last <= 4);
      allow update: if request.auth != null
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last', 'gLast'])
            && request.resource.data.last > resource.data.get('last', 0)
            && request.resource.data.last <= resource.data.get('last', 0) + 4);
    }
  }
}
