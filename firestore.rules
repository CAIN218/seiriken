rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // 誰でも閲覧可。ログイン済みスタッフのみ変更可。お客さんは発券（counters更新＋ticket作成）のみ可
    match /tickets/{id} {
      allow read: if true;
      allow create: if request.resource.data.status == 'waiting'
        && request.resource.data.people in [1, 2];
      allow update, delete: if request.auth != null;
    }
    match /counters/{day} {
      allow read: if true;
      allow create, update: if true;
    }
  }
}
