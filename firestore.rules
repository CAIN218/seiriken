rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // 誰でも閲覧可。ログイン済みスタッフのみ変更可。お客さんは発券（counters更新＋ticket作成）のみ可
    match /tickets/{id} {
      allow read: if true;
      allow create: if request.resource.data.status == 'waiting'
        && request.resource.data.people in [1, 2]
        && (!('name' in request.resource.data) || request.resource.data.name.size() <= 12);
      allow update, delete: if request.auth != null;
    }
    match /counters/{day} {
      allow read: if true;
      // お客さんは発券時の last の更新だけ可（停止フラグなどはスタッフのみ）
      allow create: if request.auth != null
        || (request.resource.data.keys().hasOnly(['last']) && request.resource.data.last == 1);
      allow update: if request.auth != null
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last'])
            && request.resource.data.last == resource.data.get('last', 0) + 1);
    }
  }
}
